{
  "id": "c546076e-dca0-49fe-8020-97296b5d5a15",
  "version": "1.1",
  "name": "ContractComparisonProcess",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Manual trigger"
      },
      "inputs": {
        "entryPointId": "22b168ff-857b-4439-89d2-0faca5b13e51",
        "isDefaultEntryPoint": true
      }
    },
    {
      "id": "extractor",
      "type": "uipath.core.agent.5aac7787-422a-40b9-94e7-fbc09ba05701",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Extractor",
        "icon": "coded-agent"
      },
      "inputs": {
        "bucket_name": "=js:$vars.start.output.bucketName",
        "doc_a_key": "=js:$vars.start.output.docAKey",
        "doc_b_key": "=js:$vars.start.output.docBKey",
        "workspace_id": "=js:$vars.start.output.workspaceId",
        "comparison_id": "=js:$vars.start.output.comparisonId",
        "include_version_history": "=js:$vars.start.output.includeVersionHistory",
        "prior_version_keys": "=js:[]"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the agent",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the agent fails",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "comparator",
      "type": "uipath.core.agent.e8bdcdf7-e581-4bc3-a9b3-628866fac0f0",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Comparator",
        "icon": "coded-agent"
      },
      "inputs": {
        "doc_a": "=js:$vars.extractor.output.doc_a",
        "doc_b": "=js:$vars.extractor.output.doc_b",
        "mode": "=js:$vars.start.output.mode",
        "template_system_message": "=js:$vars.start.output.templateSystemMessage",
        "linked_guideline_ids": "=js:$vars.start.output.linkedGuidelineIds",
        "batch_size": 7
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the agent",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the agent fails",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "hitlReview",
      "type": "uipath.human-in-the-loop",
      "typeVersion": "1.0",
      "display": {
        "label": "Human Review"
      },
      "inputs": {
        "type": "quick",
        "schema": {
          "schemaId": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
          "fields": [
            {
              "id": "comparisonId",
              "label": "Comparison ID",
              "type": "text",
              "direction": "input",
              "binding": "vars.start.output.comparisonId"
            },
            {
              "id": "workspaceId",
              "label": "Workspace ID",
              "type": "text",
              "direction": "input",
              "binding": "vars.start.output.workspaceId"
            },
            {
              "id": "rejectionNote",
              "label": "Rejection Note",
              "type": "text",
              "direction": "output",
              "variable": "vars.rejectionNote"
            }
          ],
          "outcomes": [
            {
              "id": "confirm",
              "name": "Confirm",
              "type": "string",
              "isPrimary": true,
              "action": "Continue"
            },
            {
              "id": "reject",
              "name": "Reject",
              "type": "string",
              "isPrimary": false,
              "action": "Continue"
            }
          ]
        },
        "recipient": {
          "channels": [
            "Email",
            "ActionCenter"
          ],
          "connections": {},
          "assignee": {
            "type": "group"
          }
        },
        "priority": "Medium"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Task result data",
          "source": "=result",
          "var": "output",
          "properties": {
            "rejectionNote": {
              "type": "string"
            },
            "Action": {
              "type": "string",
              "enum": [
                "Confirm",
                "Reject"
              ],
              "default": "Confirm"
            }
          }
        },
        "status": {
          "type": "string",
          "description": "Task completion status",
          "source": "=result.Action",
          "var": "status",
          "enum": [
            "Confirm",
            "Reject"
          ],
          "default": "Confirm"
        }
      }
    },
    {
      "id": "reviewer",
      "type": "uipath.core.agent.2c3317a8-68cc-4167-ba23-f18d2aa922df",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Reviewer",
        "icon": "coded-agent"
      },
      "inputs": {
        "workspace_id": "=js:$vars.start.output.workspaceId",
        "comparison_id": "=js:$vars.start.output.comparisonId",
        "bucket_name": "=js:$vars.start.output.bucketName",
        "mode": "=js:$vars.start.output.mode",
        "findings": "=js:$vars.comparator.output.findings",
        "template_system_message": "=js:$vars.start.output.templateSystemMessage",
        "task_id": 0
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the agent",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the agent fails",
          "source": "=result.Error",
          "var": "error"
        }
      }
    },
    {
      "id": "routeDecision",
      "type": "core.logic.switch",
      "typeVersion": "1.0",
      "display": {
        "label": "Route Decision"
      },
      "inputs": {
        "cases": [
          {
            "id": "confirm",
            "label": "Confirmed",
            "expression": "$vars.hitlReview.status === 'Confirm'"
          },
          {
            "id": "reject",
            "label": "Rejected",
            "expression": "$vars.hitlReview.status === 'Reject'"
          }
        ]
      }
    },
    {
      "id": "endConfirmed",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Confirmed"
      },
      "inputs": {}
    },
    {
      "id": "endRejected",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Rejected"
      },
      "inputs": {}
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source": "start",
      "sourcePort": "output",
      "target": "extractor",
      "targetPort": "input"
    },
    {
      "id": "e2",
      "source": "extractor",
      "sourcePort": "output",
      "target": "comparator",
      "targetPort": "input"
    },
    {
      "id": "e3",
      "source": "comparator",
      "sourcePort": "output",
      "target": "reviewer",
      "targetPort": "input"
    },
    {
      "id": "e4",
      "source": "reviewer",
      "sourcePort": "output",
      "target": "hitlReview",
      "targetPort": "input"
    },
    {
      "id": "e5",
      "source": "hitlReview",
      "sourcePort": "completed",
      "target": "routeDecision",
      "targetPort": "input"
    },
    {
      "id": "e6",
      "source": "routeDecision",
      "sourcePort": "case-confirm",
      "target": "endConfirmed",
      "targetPort": "input"
    },
    {
      "id": "e7",
      "source": "routeDecision",
      "sourcePort": "case-reject",
      "target": "endRejected",
      "targetPort": "input"
    }
  ],
  "definitions": [
